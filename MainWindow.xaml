<Window x:Class="MovieConcatenater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MovieConcatenater"
        Icon="Assets/app-icon.ico"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 実行中はタブ全体を無効化（中止はステータスバーのみ） -->
        <TabControl x:Name="MainTabs"
                    Grid.Row="0"
                    Margin="12,12,12,8"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem x:Name="ConcatTab" Header="連結">
                <DockPanel x:Name="MainContentPanel"
                           Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               FontSize="13"
                               Text="動画ファイルをここにドラッグ＆ドロップ（同一コーデック・解像度の分割ファイルを連結）" />

                    <ListView x:Name="FileListView"
                              AlternationCount="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="順" Width="40" DisplayMemberBinding="{Binding Order}" />
                                <GridViewColumn Header="ファイル名" Width="180" DisplayMemberBinding="{Binding FileName}" />
                                <GridViewColumn Header="フルパス" Width="280" DisplayMemberBinding="{Binding FullPath}" />
                                <GridViewColumn Header="解像度" Width="90" DisplayMemberBinding="{Binding Resolution}" />
                                <GridViewColumn Header="映像" Width="80" DisplayMemberBinding="{Binding VideoCodec}" />
                                <GridViewColumn Header="音声" Width="80" DisplayMemberBinding="{Binding AudioCodec}" />
                                <GridViewColumn Header="fps" Width="60" DisplayMemberBinding="{Binding FrameRate}" />
                                <GridViewColumn Header="時間" Width="90" DisplayMemberBinding="{Binding DurationText}" />
                                <GridViewColumn Header="状態" Width="140" DisplayMemberBinding="{Binding StatusText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ResizeTab" Header="解像度変更">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,0,0,8"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="解像度を変更し、新ファイルに出力します" />
                        <ComboBox x:Name="ResolutionCombo"
                                  Width="160"
                                  Height="26"
                                  Margin="16,0,0,0"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Label"
                                  ToolTip="出力解像度（選択行に適用。未選択時は追加するファイルの既定値。縦横比を保って縮小）"
                                  SelectionChanged="ResolutionCombo_SelectionChanged" />
                        <ComboBox x:Name="FpsCombo"
                                  Width="100"
                                  Height="26"
                                  Margin="8,0,0,0"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Label"
                                  ToolTip="出力 FPS（選択行に適用。未選択時は追加するファイルの既定値）"
                                  SelectionChanged="FpsCombo_SelectionChanged" />
                    </StackPanel>

                    <ListView x:Name="ResizeFileListView"
                              SelectionMode="Extended"
                              SelectionChanged="ResizeFileListView_SelectionChanged"
                              PreviewKeyDown="ResizeFileListView_PreviewKeyDown">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding OutputFullPath}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ファイル名" Width="170" DisplayMemberBinding="{Binding Source.FileName}" />
                                <GridViewColumn Header="解像度" Width="85" DisplayMemberBinding="{Binding Source.Resolution}" />
                                <GridViewColumn Header="映像" Width="60" DisplayMemberBinding="{Binding Source.VideoCodec}" />
                                <GridViewColumn Header="音声" Width="60" DisplayMemberBinding="{Binding Source.AudioCodec}" />
                                <GridViewColumn Header="fps" Width="55" DisplayMemberBinding="{Binding Source.FrameRate}" />
                                <GridViewColumn Header="時間" Width="85" DisplayMemberBinding="{Binding Source.DurationText}" />
                                <GridViewColumn Header="出力サイズ" Width="85" DisplayMemberBinding="{Binding OutputSizeText}" />
                                <GridViewColumn Header="出力fps" Width="65" DisplayMemberBinding="{Binding Fps.Label}" />
                                <GridViewColumn Header="出力パス" Width="240" DisplayMemberBinding="{Binding OutputFullPath}" />
                                <GridViewColumn Header="状態" Width="120" DisplayMemberBinding="{Binding StatusText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>

        <Border x:Name="OptionsPanel"
                Grid.Row="1"
                Margin="12,0,12,8"
                Padding="10"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="出力フォルダ" />
                <TextBox x:Name="OutputFolderBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,6"
                         Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="OutputPathFields_TextChanged" />
                <Button x:Name="BrowseOutputFolderButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,0,6"
                        Width="88"
                        Height="26"
                        Content="参照…"
                        Click="BrowseOutputFolder_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="出力ファイル名" />
                <TextBox x:Name="OutputFileNameBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,6"
                         Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="OutputPathFields_TextChanged" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="出力フルパス" />
                <TextBox x:Name="OutputFullPathBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,6"
                         Height="26"
                         VerticalContentAlignment="Center"
                         LostFocus="OutputFullPathBox_LostFocus" />

                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="FFmpeg パス" />
                <TextBox x:Name="FfmpegPathBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="0,0,8,0"
                         Height="26"
                         VerticalContentAlignment="Center"
                         ToolTip="空欄の場合は PATH 上の ffmpeg を使用します" />
                <Button x:Name="BrowseFfmpegButton"
                        Grid.Row="3"
                        Grid.Column="2"
                        Width="88"
                        Height="26"
                        Content="参照…"
                        Click="BrowseFfmpeg_Click" />
            </Grid>
        </Border>

        <StackPanel x:Name="ActionPanel"
                    Grid.Row="2"
                    Margin="12,0,12,8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="ClearButton"
                    Width="88"
                    Height="28"
                    Margin="0,0,8,0"
                    Content="クリア"
                    Click="Clear_Click" />
            <Button x:Name="RunButton"
                    Width="100"
                    Height="28"
                    Content="実行"
                    FontWeight="SemiBold"
                    Click="Run_Click" />
        </StackPanel>

        <!-- 中止はステータスバーのみ（IndigoMovieManager と同様） -->
        <Border x:Name="OperationStatusBar"
                Grid.Row="3"
                Height="26"
                Background="#F0F0F0"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0">
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="4,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1"
                             Height="4"
                             VerticalAlignment="Center"
                             Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button x:Name="StatusCancelButton"
                        Grid.Column="2"
                        Height="18"
                        MinWidth="0"
                        Margin="4,0,10,0"
                        Padding="7,0"
                        VerticalAlignment="Center"
                        Content="中止"
                        FontSize="10"
                        Click="Cancel_Click"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
