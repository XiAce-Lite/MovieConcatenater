<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MovieConcatenater</RootNamespace>
    <AssemblyName>MovieConcatenater</AssemblyName>
    <Product>MovieConcatenater</Product>
    <Title>MovieConcatenater</Title>
    <Description>同一コーデックの分割動画を FFmpeg で連結する Windows アプリ</Description>
    <ApplicationIcon />
    <Platforms>AnyCPU;x64</Platforms>
    <!-- WPF 衛星アセンブリ（cs/de/fr 等）を出さない。ja のみ残して Single File に含める -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 配布用: Exe 単体（自己完結 + Single File） -->
  <PropertyGroup Condition="'$(DistributionPublish)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

</Project>
